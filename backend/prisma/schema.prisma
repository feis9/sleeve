// Base del backend: SQLite con Prisma, como en la Práctica Prisma.
// Para crearla: npm run db:init (prisma generate + prisma db push).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Réplica de las ediciones de Discogs ya consultadas, para no gastar el límite de pedidos ni volver a pedir
// lo mismo. Es una réplica con vencimiento, no la fuente de los datos: los términos de Discogs no permiten
// mostrar datos con más de 6 horas, así que pasado ese tiempo se vuelve a pedir (src/ediciones.ts).
// Va en columnas y tablas, y no como un JSON, para que la base sepa qué guarda: se puede consultar y filtrar
// con SQL (por ejemplo, buscar por código de barras) y cada campo tiene su tipo.
//
// A propósito, ColeccionItem y Resena NO tienen una relación con Edicion: guardan el número de release como
// texto. Si la tuvieran, borrar una edición vencida de la réplica borraría (o bloquearía) colecciones y reseñas.
model Edicion {
  // Número de release de Discogs.
  id            Int      @id
  title         String
  // Artistas unidos como figuran en la tapa ("Art Blakey And The Jazz Messengers*").
  artist        String
  // Los campos que Discogs puede no tener son opcionales: la app muestra la edición igual.
  year          Int?
  country       String?
  label         String?
  format        String?
  genre         String?
  barcode       String?
  discogsRating Float?
  coverUrl      String?
  // Cuándo se le pidió a Discogs. De acá sale la vigencia de 6 horas.
  consultadaEn  DateTime
  temas         Tema[]
  plantas       Planta[]
}

// Un tema del tracklist. Una edición tiene muchos (relación 1 a N).
model Tema {
  edicionId Int
  // Al borrar la edición se borran sus temas.
  edicion   Edicion @relation(fields: [edicionId], references: [id], onDelete: Cascade)
  // Posición en la lista (0, 1, 2…). No alcanza con "position" ("A1", "B2"): puede repetirse o venir vacía.
  orden     Int
  position  String
  title     String
  // Discogs no siempre tiene la duración.
  duration  String?

  @@id([edicionId, orden])
}

// Una planta de prensado ("Pressed By" en Discogs). Una edición puede tener varias o ninguna.
model Planta {
  edicionId Int
  edicion   Edicion @relation(fields: [edicionId], references: [id], onDelete: Cascade)
  orden     Int
  nombre    String

  @@id([edicionId, orden])
}

// Cuenta de Sleeve. La contraseña nunca se guarda: se guarda su hash con scrypt (src/contrasenas.ts).
model Usuario {
  // Texto y no número: las cuentas de prueba conservan los ids de la app ("u-luca"), que son las
  // claves de sus colecciones. Las cuentas nuevas reciben un id generado.
  id          String   @id @default(cuid())
  // Usuario y email se guardan en minúsculas, así "LucaF" y "lucaf" son la misma cuenta.
  username    String   @unique
  email       String   @unique
  name        String
  // "sal:hash" en hexadecimal. Se llama passwordHash y no password para que nadie lo confunda con la contraseña.
  passwordHash String
  avatarColor String
  createdAt   DateTime @default(now())
  resenas     Resena[]
  coleccion   ColeccionItem[]
  sesiones    Sesion[]
}

// Una sesión iniciada: se crea en cada login o registro. Un usuario puede tener varias (un teléfono cada una).
model Sesion {
  // SHA-256 del token que tiene la app (src/sesiones.ts). El token mismo nunca se guarda.
  tokenHash String   @id
  usuarioId String
  // Si se borra el usuario, se borran sus sesiones.
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  creadaEn  DateTime @default(now())
  // Pasada esta fecha, el token deja de servir y hay que volver a entrar.
  expiraEn  DateTime
}

// Un disco en la colección de un usuario. Si el GPS respondió al agregarlo, también dónde lo encontró.
model ColeccionItem {
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // Número de release de Discogs como texto, igual que el id de los discos en la app.
  releaseId  String
  agregadoEn DateTime  @default(now())
  // Hallazgo (tipo Find de la app). Van juntos o vacíos: el disco se agrega aunque el GPS falle.
  latitude   Float?
  longitude  Float?
  // "San Telmo, Buenos Aires". Puede quedar vacío aunque haya coordenadas.
  place      String?
  foundAt    DateTime?

  // Un mismo disco una sola vez por usuario.
  @@id([usuarioId, releaseId])
}

// Reseña de una edición. Una por usuario y edición: escribir otra reemplaza la anterior, como en la app.
model Resena {
  id        String   @id @default(cuid())
  usuarioId String
  // Si se borra el usuario, se borran sus reseñas.
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  // Número de release de Discogs como texto, igual que el id de los discos en la app.
  releaseId String
  rating    Int
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([usuarioId, releaseId])
}
